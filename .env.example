# ---- Database ----
# Local dev (docker compose): postgres://studymate:studymate@localhost:5432/studymate
# Production (Neon, pooled): postgres://<user>:<pw>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgres://studymate:studymate@localhost:5432/studymate

# ---- Better Auth ----
# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-please-32chars-min
BETTER_AUTH_URL=http://localhost:3000

# ---- KMITL SSO (generic OIDC via Better Auth genericOAuth) ----
# Register an SSO client at https://developer.kmitl.ac.th (OpenID Connect).
# Client ID looks like: <id>.developer.kmitl.ac.th
# Redirect URI to register: ${BETTER_AUTH_URL}/api/auth/oauth2/callback/kmitl
# ISSUER's /.well-known/openid-configuration is used for discovery + logout.
# Until these are set, login is disabled (public pages still work).
KMITL_SSO_CLIENT_ID=
KMITL_SSO_CLIENT_SECRET=
KMITL_SSO_ISSUER=https://sso.kmitl.ac.th/realms/master

# The 8-digit student id is NOT in the default (openid profile email) claims —
# request it from KDMC, then set this to the granted claim name (e.g. student_id).
# Left blank, the user handle falls back to preferred_username / sub.
KMITL_SSO_STUDENT_ID_CLAIM=
