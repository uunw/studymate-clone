# ---- Database ----
# Local dev (docker compose): postgres://studymate:studymate@localhost:5432/studymate
# Production (Neon, pooled): postgres://<user>:<pw>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgres://studymate:studymate@localhost:5432/studymate

# ---- Better Auth ----
# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-please-32chars-min
# Must match the origin you open in the browser (scheme + host + port). If your
# browser force-upgrades http->https on localhost (HSTS / "always use https"),
# use https://127.0.0.1:3000 — vite serves TLS automatically when apps/web/certs/
# holds a self-signed cert (see apps/web/vite.config.ts).
BETTER_AUTH_URL=http://localhost:3000

# ---- KMITL SSO (generic OIDC via Better Auth genericOAuth) ----
# Registrar realm (verified working): public PKCE client, no client secret needed.
# Redirect URI used: ${BETTER_AUTH_URL}/api/auth/oauth2/callback/kmitl
# ISSUER's /.well-known/openid-configuration drives discovery + Single Logout.
# Until CLIENT_ID + ISSUER are set, login is disabled (public pages still work).
KMITL_SSO_CLIENT_ID=KMITL-client
KMITL_SSO_CLIENT_SECRET=
KMITL_SSO_ISSUER=https://sso.reg.kmitl.ac.th/realms/registrar

# The registrar id_token carries the 8-digit student id as preferred_username (and
# sometimes a student_id claim); deriveUsername() picks it up automatically. Set
# this only if a different claim holds the id.
KMITL_SSO_STUDENT_ID_CLAIM=student_id

# Alt: a self-registered client on developer.kmitl.ac.th + realms/master — was
# blocked by a "Client not found" provisioning gap (see CLAUDE.md landmines):
# KMITL_SSO_CLIENT_ID=<id>.developer.kmitl.ac.th
# KMITL_SSO_CLIENT_SECRET=<secret>
# KMITL_SSO_ISSUER=https://sso.kmitl.ac.th/realms/master

# ---- Firebase (migration: SPA + Firestore + Auth, see MIGRATION.md) ----
# Public web config (NOT secret — security is via Firestore Rules). Get from the
# Firebase console → Project settings → Your apps → SDK setup (phase 1).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
