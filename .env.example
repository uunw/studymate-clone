# ---- Database ----
# Local dev (docker compose): postgres://studymate:studymate@localhost:5432/studymate
# Production (Neon, pooled): postgres://<user>:<pw>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgres://studymate:studymate@localhost:5432/studymate

# ---- Better Auth ----
# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-please-32chars-min
BETTER_AUTH_URL=http://localhost:3000

# ---- Google OAuth (KMITL domain restricted) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- SMTP (email OTP). Leave blank in dev -> OTP printed to server console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="StudyMate <no-reply@studymate.local>"

# ---- File storage (profile pictures). Blank in dev -> local /uploads ----
BLOB_READ_WRITE_TOKEN=
