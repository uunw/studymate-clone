{
	"name": "@repo/db",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./client": "./src/client.ts"
	},
	"scripts": {
		"generate": "drizzle-kit generate",
		"migrate": "drizzle-kit migrate",
		"push": "drizzle-kit push",
		"studio": "drizzle-kit studio",
		"seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
		"seed:firestore": "tsx --env-file-if-exists=../../.env src/seed-firestore.ts",
		"seed:reviews": "tsx --env-file-if-exists=../../.env src/seed-reviews-firestore.ts",
		"seed:ce": "tsx --env-file-if-exists=../../.env src/seed-ce-curriculum.ts",
		"import:regis": "tsx --env-file-if-exists=../../.env src/import-regis.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"clean": "rm -rf dist .turbo"
	},
	"dependencies": {
		"drizzle-orm": "catalog:",
		"pg": "^8.13.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/pg": "^8.11.10",
		"drizzle-kit": "catalog:",
		"firebase-admin": "^14.0.0",
		"tsx": "^4.19.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
