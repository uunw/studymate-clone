{
	"name": "studymate-clone",
	"version": "0.1.0",
	"private": true,
	"description": "Open-source rebuild of StudyMate (KMITL) on a modern TanStack + Drizzle + Better Auth stack.",
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"db:generate": "pnpm --filter @repo/db generate",
		"db:migrate": "pnpm --filter @repo/db migrate",
		"db:push": "pnpm --filter @repo/db push",
		"db:seed": "pnpm --filter @repo/db seed",
		"db:studio": "pnpm --filter @repo/db studio",
		"clean": "turbo run clean && rm -rf node_modules"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"turbo": "^2.5.0",
		"typescript": "catalog:"
	}
}
